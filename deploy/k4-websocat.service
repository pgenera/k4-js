[Unit]
Description=Elecraft K4 WebSocket-to-TCP Bridge (websocat)
Documentation=https://github.com/vi/websocat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=k4web
Group=k4web
# Configure K4_HOST (e.g., 192.168.1.50) and K4_PORT (9205) in /etc/default/k4-bridge
Environment=K4_HOST=127.0.0.1
Environment=K4_PORT=9205
Environment=WS_BIND=127.0.0.1:9280
EnvironmentFile=-/etc/default/k4-bridge

# IMPORTANT:
#   `websocat -b --websocket-protocol binary` accepts `Sec-WebSocket-Protocol: binary`
#   (compatible with both browser `binary` mode and `auto` mode without fallback delay).
#   Running bare `websocat --binary` WITHOUT `--websocket-protocol` rejects clients that
#   advertise `['binary']`, causing K4.Client's `auto` mode to fall back to bare WS.
ExecStart=/usr/local/bin/websocat -E -b --websocket-protocol binary ws-l:${WS_BIND} tcp:${K4_HOST}:${K4_PORT}
Restart=on-failure
RestartSec=2s

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
